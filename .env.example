# ==============================================================================
# 나만의 옷장 (My AI Closet) — 서버 환경변수 예시
# 실제 API 키나 비밀정보를 이 파일에 넣지 마세요. (.env 파일에만 작성)
# ==============================================================================

# [필수] Google Gemini API 키 (서버 측에서만 사용되며 클라이언트에 노출되지 않음)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# [선택] 실행 포트 (Render에서는 자동으로 PORT 환경변수를 주입함, 로컬 기본값: 3000)
PORT="3000"

# [선택] 실행 환경 (Render Web Service 배포 시 production 설정)
NODE_ENV="development"

# [선택] 프로덕션 CORS 허용 출처 목록 (쉼표로 구분, 미설정 시 동일 출처 및 RENDER_EXTERNAL_URL 허용)
# 예: CORS_ORIGINS="https://my-ai-closet.onrender.com,https://closet.example.com"
CORS_ORIGINS=""

# [선택] AI API Rate Limiting 설정 (기본값: 60000ms 동안 IP당 일반 20회 / 실사 미리보기 8회)
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="20"
PREVIEW_RATE_LIMIT_MAX="8"
